[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Optional: serve MkDocs output at /docs/ and OpenAPI at /openapi.yaml + /swagger/
# (defaults: docs/docs/_out and docs/swagger relative to the process working directory).
# docs_dir = "docs/docs/_out"
# swagger_dir = "docs/swagger"

# List Pocket uses embedded PocketBase for storage, auth, and realtime. Application
# data lives in PocketBase’s SQLite database (default directory: pb_data/). There is
# no separate PostgreSQL server to configure.
